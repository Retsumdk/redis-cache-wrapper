{
  "name": "redis-cache-wrapper",
  "description": "Typed, backend-agnostic caching layer for API responses with TTL, namespacing, and hit/miss observability. In-memory for dev, Redis for production.",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "redis-cache-wrapper": "./dist/cli.js"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "bun test",
    "build": "tsc",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "cache",
    "redis",
    "caching",
    "ttl",
    "memoize",
    "api",
    "wrapper",
    "ioredis",
    "typescript"
  ],
  "license": "MIT",
  "author": "Retsumdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/redis-cache-wrapper.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0",
    "typescript": "^5.3.0"
  }
}
